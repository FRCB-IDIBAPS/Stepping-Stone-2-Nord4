# Data, outputs and run records live on the cluster, not in git
output/*
!output/.gitkeep
results/
/reference/
bin/out/
bin/err/

# Task datasets: keep each SOURCE.md (provenance + download commands), not the
# large files; they are fetched again with src/data/download.sh
src/data/**/*.fastq.gz
src/data/**/*.fa

# Singularity images are built from singularity/bin/*.def (too big for git)
singularity/images/*
!singularity/images/.gitkeep
*.sif
