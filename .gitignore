# Data, outputs and run records live on the cluster, not in git
output/*
!output/.gitkeep
results/
/reference/
bin/out/
bin/err/

# Task datasets (src/data/) ARE tracked, so a clone is ready to run.
# Temporary files of src/data/download.sh are not:
src/data/**/.*.part
src/data/**/*.part

# Singularity images are built from singularity/bin/*.def (too big for git)
singularity/images/*
!singularity/images/.gitkeep
*.sif
